<mxfile host="app.diagrams.net" agent="Mizan" version="24.7.17" type="device">
  <diagram id="mizan-cloud-architecture" name="Mizan Cloud architecture">
    <mxGraphModel dx="1600" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="background" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8F4F1;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1520" height="1050" as="geometry"/></mxCell>
        <mxCell id="title" value="Mizan / GPU jobs in your cloud account" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=32;fontStyle=1;fontColor=#272320;" vertex="1" parent="1"><mxGeometry x="70" y="35" width="1250" height="55" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Azure / Nebius / Google Cloud / AWS. The desktop keeps the library and manages the selected provider." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=16;fontColor=#635c57;" vertex="1" parent="1"><mxGeometry x="72" y="95" width="1300" height="35" as="geometry"/></mxCell>
        <mxCell id="setup-band" value="" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#C8EBEB;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70" y="155" width="1380" height="385" as="geometry"/></mxCell>
        <mxCell id="setup-header" value="SETUP  /  approve resources, permissions, and token transfer before cloud writes" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=16;fontStyle=1;fontColor=#225A69;" vertex="1" parent="1"><mxGeometry x="95" y="175" width="1270" height="36" as="geometry"/></mxCell>
        <mxCell id="identity" value="01 / ACCOUNT AND APPROVAL&#xa;Select the provider, account, region&#xa;Use existing account credentials&#xa;Review resource names and charges" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=15;fontFamily=Segoe UI;fontSize=14;fontColor=#272320;fillColor=#EEF4FF;strokeColor=#BED2F4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="95" y="245" width="300" height="155" as="geometry"/></mxCell>
        <mxCell id="resources" value="02 / PRIVATE CLOUD RESOURCES&#xa;Azure Blob / GCS / S3-compatible files&#xa;Job identity and scoped permissions&#xa;Provider job service and network" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=15;fontFamily=Segoe UI;fontSize=14;fontColor=#272320;fillColor=#E9F8F8;strokeColor=#A7D9D7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="435" y="245" width="300" height="155" as="geometry"/></mxCell>
        <mxCell id="image" value="03 / IMAGE AND MODEL ACCESS&#xa;Azure: own ACR worker build&#xa;Others: public GHCR image + SHA256&#xa;Approved token in a native secret&#xa;No weights or recordings in the image" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=15;fontFamily=Segoe UI;fontSize=14;fontColor=#272320;fillColor=#F2EDFC;strokeColor=#D7C4F2;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="775" y="245" width="300" height="155" as="geometry"/></mxCell>
        <mxCell id="gate" value="04 / READINESS CHECK&#xa;Private storage and job permissions&#xa;Matching image source and digest&#xa;Token secret and model capacity&#xa;No GPU job starts during this check" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=15;fontFamily=Segoe UI;fontSize=14;fontColor=#272320;fillColor=#EBF8ED;strokeColor=#C8E2BD;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1115" y="245" width="300" height="155" as="geometry"/></mxCell>
        <mxCell id="setup-note" value="New jobs use one active provider. Each queued job keeps its account and resource target. Disconnect forgets settings, not cloud resources.&#xa;GPU, storage, network, registry, and image-build charges can apply. The app does not select a cheaper provider or retry uncertain submissions." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=14;fontColor=#635c57;" vertex="1" parent="1"><mxGeometry x="98" y="435" width="1290" height="62" as="geometry"/></mxCell>
        <mxCell id="run-band" value="" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#E0E7F1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70" y="565" width="1380" height="420" as="geometry"/></mxCell>
        <mxCell id="run-header" value="ONE CLOUD ANALYSIS  /  local decode, remote inference, local library save" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=16;fontStyle=1;fontColor=#272320;" vertex="1" parent="1"><mxGeometry x="95" y="585" width="1170" height="36" as="geometry"/></mxCell>
        <mxCell id="upload" value="01 / DESKTOP&#xa;yt-dlp + FFmpeg decode the audio&#xa;Upload input.wav to private storage&#xa;Start the recorded provider job&#xa;Save the returned remote job ID" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=15;fontFamily=Segoe UI;fontSize=14;fontColor=#272320;fillColor=#EEF4FF;strokeColor=#BED2F4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="95" y="665" width="300" height="160" as="geometry"/></mxCell>
        <mxCell id="blob" value="02 / PRIVATE JOB FILES&#xa;Recording under jobs/{random ID}&#xa;Job identity reads input, writes output&#xa;Results, checksums, and six stems&#xa;No public recording access" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=15;fontFamily=Segoe UI;fontSize=14;fontColor=#272320;fillColor=#E9F8F8;strokeColor=#A7D9D7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="435" y="665" width="300" height="160" as="geometry"/></mxCell>
        <mxCell id="gpu" value="03 / PROVIDER GPU JOB&#xa;Pull the pinned CUDA worker image&#xa;Download and check pinned weights&#xa;HT-Demucs + selected MuScriptor&#xa;Mix and vocal-stem note events" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=15;fontFamily=Segoe UI;fontSize=14;fontColor=#272320;fillColor=#F2EDFC;strokeColor=#D7C4F2;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="775" y="665" width="300" height="160" as="geometry"/></mxCell>
        <mxCell id="save" value="04 / DESKTOP LIBRARY&#xa;Poll, download, and validate outputs&#xa;Build harmony and draft score locally&#xa;Save the score, stems, and exports&#xa;Then delete known remote job files" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=15;fontFamily=Segoe UI;fontSize=14;fontColor=#272320;fillColor=#EBF8ED;strokeColor=#C8E2BD;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1115" y="665" width="300" height="160" as="geometry"/></mxCell>
        <mxCell id="run-note" value="Changing providers cannot redirect status, cancellation, or cleanup. Successful remote outputs stay until the local library saves them.&#xa;If submission or cancellation remains uncertain, retain the files for investigation. Confirmed failure or cancellation permits cleanup of known files." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=14;fontColor=#635c57;" vertex="1" parent="1"><mxGeometry x="98" y="865" width="1290" height="72" as="geometry"/></mxCell>
        <mxCell id="services" value="Azure: Container Apps Jobs + Blob  |  Nebius: Serverless AI + Object Storage  |  Google Cloud: Batch + Cloud Storage  |  AWS: Batch on EC2 + S3" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=12;fontColor=#635c57;" vertex="1" parent="1"><mxGeometry x="95" y="1000" width="1320" height="30" as="geometry"/></mxCell>
        <mxCell id="setup-a1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#19A3A3;strokeWidth=2;" edge="1" parent="1" source="identity" target="resources"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="setup-a2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#19A3A3;strokeWidth=2;" edge="1" parent="1" source="resources" target="image"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="setup-a3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#60A467;strokeWidth=2;" edge="1" parent="1" source="image" target="gate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="run-a1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#19A3A3;strokeWidth=2;" edge="1" parent="1" source="upload" target="blob"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="run-a2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9C75C5;strokeWidth=2;" edge="1" parent="1" source="blob" target="gpu"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="run-a3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#60A467;strokeWidth=2;" edge="1" parent="1" source="gpu" target="save"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
