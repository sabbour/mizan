        <mxCell id="cloud-return" value="04 / BACK TO LIBRARY&#xa;Validate outputs and all six stems&#xa;Save locally, then clean remote files" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=15;fontFamily=Segoe UI;fontSize=14;fontColor=#272320;fillColor=#EBF8ED;strokeColor=#C8E2BD;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1085" y="1165" width="290" height="112" as="geometry"/></mxCell>
        <mxCell id="cloud-gate" value="Each queued job keeps its provider and resource target. Changing providers cannot redirect that job or its cleanup.&#xa;Readiness checks do not start a GPU job. Setup requires approval for resources, permissions, and token transfer.&#xa;Connection, permission, quota, and processing errors remain visible. There is no automatic fallback." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=14;fontColor=#635c57;" vertex="1" parent="1"><mxGeometry x="98" y="1310" width="1270" height="88" as="geometry"/></mxCell>
