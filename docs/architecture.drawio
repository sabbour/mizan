        <mxCell id="cloud-header" value="OPTIONAL CLOUD GPU  /  Model size depends on the selected job resources" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=16;fontStyle=1;fontColor=#225A69;" vertex="1" parent="1"><mxGeometry x="94" y="1092" width="1000" height="38" as="geometry"/></mxCell>
        <mxCell id="cloud-consent" value="01 / SIGN IN + APPROVE&#xa;Choose the account and region&#xa;Review resources and charges" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=15;fontFamily=Segoe UI;fontSize=14;fontColor=#272320;fillColor=#E9F8F8;strokeColor=#A7D9D7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="94" y="1165" width="290" height="112" as="geometry"/></mxCell>
        <mxCell id="cloud-resources" value="02 / YOUR CLOUD ACCOUNT&#xa;Azure / Nebius / Google Cloud / AWS&#xa;Private storage + job identity" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=15;fontFamily=Segoe UI;fontSize=14;fontColor=#272320;fillColor=#E9F8F8;strokeColor=#A7D9D7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="425" y="1165" width="290" height="112" as="geometry"/></mxCell>
